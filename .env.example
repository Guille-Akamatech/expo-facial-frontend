# Copia este archivo a ".env" y reemplaza los valores con los que obtengas
# al desplegar la infraestructura (ver INSTRUCCIONES.md, Paso 3 y Paso 5).

# Región donde desplegaste todo (debe ser una de las 5 que soportan Face Liveness)
VITE_AWS_REGION=us-east-1

# ID del Cognito Identity Pool (formato: us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
VITE_IDENTITY_POOL_ID=

# URL base de tu API Gateway (sin slash final), ej: https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=
